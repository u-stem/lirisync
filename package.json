{
  "name": "lirisync",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "eval"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck && tsc -p scripts",
    "test": "bun test",
    "eval": "bun eval/run.ts",
    "eval:all": "bun eval/pipeline.ts",
    "eval:labels": "bun eval/labels-from-exo.ts",
    "eval:log": "bun eval/copy-log.ts",
    "eval:separate": "bun eval/separate.ts",
    "licenses": "bun scripts/licenses/check-npm.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
